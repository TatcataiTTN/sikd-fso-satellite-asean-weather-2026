    subgraph GRAPH["build_isl_graph — mô hình '+Grid'"]
        direction TB
        G1["Trong mỗi mặt phẳng: sort theo mean_anomaly<br/>nối fore/aft (vòng tròn, wrap-around đầu-cuối)<br/>→ 2 link/vệ tinh"]
        G2["Mỗi vệ tinh: nối sang vệ tinh GẦN PHA NHẤT<br/>ở 2 mặt phẳng liền kề (theo thứ tự RAAN)<br/>→ 2 link nữa"]
        G1 --> G2
    end
    CLUSTER --> GRAPH

    ISLGRAPH["Đồ thị ISL: 1019 node, 2652 cạnh<br/>median degree = 4 (601/1019 sat)<br/>4 mặt phẳng thưa → vài 'hub' bậc cao tới 34<br/>(giới hạn đã biết, không phá vỡ BFS)"]
    GRAPH --> ISLGRAPH

    PICKUP["Pickup: vệ tinh S bay qua city_i tại t_pick<br/>(lấy mẫu 200 pickup/thành phố gốc,<br/>KHÔNG full enumeration — ghi rõ)"]
    ISLGRAPH --> PICKUP

    BFS["bfs_hop_distance(graph, S)<br/>1 lần/vệ tinh (cache theo sat_id,<br/>vì hop-distance CHỈ phụ thuộc vệ tinh pickup,<br/>không phụ thuộc t_pick hay đích)<br/>→ dict {sat_id: n_hops}"]
    PICKUP --> BFS

    CANDS["_feasible_candidates:<br/>với mỗi pass của mọi vệ tinh qua city_j,<br/>giữ lại nếu t_rise ≥ t_pick + n_hops×0.5'<br/>(khóa đã kịp đến vệ tinh đó qua ISL)"]
    BFS --> CANDS

    SPLIT{"2 sub-algorithm, CÙNG tập candidate"}
    CANDS --> SPLIT

    TIMEOPT["time_optimal_relay<br/>chọn candidate t_rise SỚM NHẤT<br/>→ latency = t_rise − t_pick"]
    CAPOPT["capacity_optimal_relay<br/>lọc candidate trong ngân sách<br/>≤ 3× latency time-optimal<br/>→ zenith=90−elev → compute_channel<br/>→ compute_sikd_performance → SKR_kbps<br/>→ delivered_gbit = SKR×duration<br/>→ chọn delivered_gbit LỚN NHẤT"]

    SPLIT --> TIMEOPT
    SPLIT --> CAPOPT

    AGG["Tổng hợp theo cặp (i,j):<br/>median latency, median n_hops,<br/>median elev/delivered_gbit (capacity),<br/>% pickup mà 2 thuật toán chọn KHÁC vệ tinh<br/>(pct_pickups_diff_satellite — KHÔNG so median n_hops,<br/>vì 2 vệ tinh khác nhau vẫn có thể cùng số hop)"]
    TIMEOPT --> AGG
    CAPOPT --> AGG

    ROWS["28 dòng SF có hướng<br/>sf_relay_detail_56pairs_isl.csv"]
    AGG --> ROWS

    RESULT["Kết quả: latency 2.9'-4.1' MỌI CẶP<br/>jakarta↔manila 3.49'/3.78' (gần đối xứng)<br/>75.7% pickup: 2 thuật toán chọn vệ tinh KHÁC NHAU<br/>(trade-off thời gian/dung lượng là thật, phổ biến)"]
    ROWS --> RESULT

    FIG10["fig10_isl_relay_latency_heatmap.png<br/>(hình chính)"]
    RESULT --> FIG10

    WHY["Vì sao latency gần như ĐỒNG ĐỀU mọi cặp<br/>(2.9'-4.1', không phụ thuộc khoảng cách)?<br/>Vì latency do CẤU TRÚC MESH quyết định<br/>(bậc đồ thị ~4, đường kính đồ thị nhỏ, median 4 hop<br/>tới mọi vệ tinh) — KHÔNG phải thời gian<br/>chờ 1 vệ tinh hoàn thành quỹ đạo (~90-100')"]
    RESULT -.giải thích.-> WHY

